# Gym Management System - Environment Variables Example
# Copy this to .env locally or set these in Render.com Dashboard -> Environment Variables

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gym_management?retryWrites=true&w=majority
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
NODE_ENV=production
